{
  "name": "chrome-stylize",
  "author": "Akihiro MATOBA",
  "description": "chrome extension for customize CSS and JS.",
  "version": "1.0.0",
  "manifest_version": 3,
  "web_accessible_resources": [],
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.instapaper.com/*"],
      "css": ["instapaper.com/style.css"],
      "js": ["instapaper.com/script.js"]
    },
    {
      "matches": ["https://*.goguynet.jp/*"],
      "css": ["goguynet.jp/style.css"],
      "js": ["goguynet.jp/script.js"]
    },
    {
      "matches": ["https://x.com/*"],
      "css": ["x.com/style.css"],
      "js": ["x.com/script.js"]
    },
    {
      "matches": ["https://togetter.com/*"],
      "css": ["togetter.com/style.css"],
      "js": ["togetter.com/script.js"]
    },
    {
      "matches": ["https://cloud.google.com/application/web3/faucet/*"],
      "css": ["web3.faucet/style.css"],
      "js": ["web3.faucet/script.js"]
    },
    {
      "matches": ["https://qiita.com/*"],
      "css": ["qiita.com/style.css"],
      "js": ["qiita.com/script.js"]
    },
    {
      "matches": ["https://zenn.dev/*"],
      "css": ["zenn.dev/style.css"],
      "js": ["zenn.dev/script.js"]
    },
    {
      "matches": ["https://www.itmedia.co.jp/*"],
      "css": ["itmedia/style.css"],
      "js": ["itmedia/script.js"]
    },
    {
      "matches": ["<all_urls>"],
      "css": ["all/style.css"],
      "js": ["all/script.js"]
    }
  ]
}
